# ==============================================================================
# AccessCore — Production & Local Environment Configuration
# ==============================================================================
# Copy this file to '.env' before running Docker Compose or local services:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit your actual '.env' file containing real secrets to Git.
# - The placeholders below are safe defaults for local Docker/dev environments.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL & pgvector Database Settings
# ------------------------------------------------------------------------------
# Database user and credentials used by the PostgreSQL container
POSTGRES_USER=accesscore
POSTGRES_PASSWORD=accesscore_password
POSTGRES_DB=accesscore

# Host port mapped to PostgreSQL container (use 5433 if your host already runs Postgres on 5432)
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Service Ports
# ------------------------------------------------------------------------------
# Port for the Express Backend API
BACKEND_PORT=4000

# Port for the Next.js Frontend Web Application
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# 3. Client & Frontend URLs
# ------------------------------------------------------------------------------
# URL of the backend API as reached from the browser/client
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL of the frontend application allowed by backend CORS policies
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Ollama Local AI Engine
# ------------------------------------------------------------------------------
# Default endpoint for Ollama when running natively on host (Docker Desktop bridge)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Verified default chat & generation model
OLLAMA_CHAT_MODEL=qwen2.5:3b

# Required 768-dimensional embedding model
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# 5. Security, Sessions & Authentication
# ------------------------------------------------------------------------------
# Cryptographic secret key for signing JWT session tokens (min 32 characters)
# Must match between backend and frontend
AUTH_SECRET=accesscore_production_secret_key_32chars_min_replace_me!

# Default development password applied to seeded demo personas (Priya, Marcus, Elena, Rafael, Hannah, etc.)
DEV_USER_PASSWORD=CloudDesk2026!

# Automatically seed synthetic identities, documents, and disclosure policies on startup (true/false)
AUTO_SEED=true

